# Xylocopa Environment Variables
# Copy to .env and fill in actual values

# === Host Paths (REQUIRED — must be absolute paths) ===
# Projects directory — where all project code lives on the host
HOST_PROJECTS_DIR=/home/YOUR_USERNAME/xylocopa-projects

# === Claude Config ===
# Path to Claude CLI credentials file (default: ~/.claude/.credentials.json)
# CLAUDE_CREDENTIALS_PATH=/home/YOUR_USERNAME/.claude/.credentials.json
# Claude home directory (default: ~/.claude)
# CLAUDE_HOME=~/.claude
# Claude CLI binary name or path (default: claude)
# CLAUDE_BIN=claude

# === Optional (needed for voice input) ===
OPENAI_API_KEY=

# === Worker Config ===
MAX_CONCURRENT_WORKERS=5
MAX_IDLE_AGENTS=20
TASK_TIMEOUT_SECONDS=1800
MAX_RETRIES=3
CC_MODEL=claude-opus-5-5

# --- Model Configuration ---
# TRIAGE_MODEL=gpt-4o-mini          # Model for task triage
# SUMMARY_MODEL=claude-opus-5      # Claude model for internal `claude -p` summary/insight jobs (default: claude-opus-5)
# OPENAI_QUICK_MODEL=gpt-4o-mini    # OpenAI model for quick helper calls (keyword translation, insight reranking)
# API_BASE_URL=                      # Internal API base (default: http://localhost:PORT)
# GIT_USER_NAME=Xylocopa           # Git commit author name for agent operations (written to each managed repo's local git config)
# GIT_USER_EMAIL=xylocopa@localhost  # Git commit email for agent operations

# === Sync Engine Tuning ===
# Delay (seconds) before waking sync after a hook, giving Claude time to flush JSONL (default: 0.15)
# JSONL_FLUSH_DELAY=0.15
# Interval (seconds) between session cache refreshes (default: 30)
# SESSION_CACHE_INTERVAL=30

# === Backup ===
# BACKUP_ENABLED=1
BACKUP_INTERVAL_HOURS=24
MAX_BACKUPS=48
# Custom backup directory (default: backups/)
# BACKUP_DIR=/path/to/custom/backup/dir

# === Dropbox Sync (optional; enabled per project in the web UI) ===
# App key (client id) of a Dropbox app. Leave empty to use the project's app (links through
# a static relay page at jianpengyao.github.io — no redirect URI registration needed).
# Set your own key to use a private app; register <origin>/api/dropbox/callback as a
# redirect URI in the Dropbox app console for each origin you access the UI from.
# DROPBOX_APP_KEY=
# Static relay page URL. Defaults to the project-hosted page. Set to your own copy when
# self-hosting the relay, or leave empty to use direct redirects with your own app key.
# DROPBOX_RELAY_URL=
# Where the refresh token, sync config and state DB are stored (default: data/dropbox)
# DROPBOX_SYNC_DIR=data/dropbox

# === Web Push (VAPID) ===
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:xylocopa@example.com

# === Security ===
# Comma-separated allowed CORS origins (default: http://localhost:3000,http://localhost:8080)
CORS_ORIGINS=https://localhost:3000
# Default idle lock in minutes (0 = off), used until it is set under
# Monitor > Security, which takes precedence (default: 30). The idle lock
# guards an unattended device; to cut off a lost device, revoke it there.
# AUTH_TIMEOUT_MINUTES=30
# Absolute lifetime of a login session in days, idle or not (default: 90)
# AUTH_SESSION_MAX_DAYS=90
# How often an open WebSocket re-checks its session, in seconds (default: 60)
# XY_WS_AUTH_RECHECK_S=60
# Per-agent hook nonce check: enforce (reject hooks with a wrong nonce while
# auth is on), log (log only) or off (default: enforce)
# XY_HOOK_NONCE_MODE=enforce
# Set to 1 to disable login authentication (dev only — do not use in production)
# DISABLE_AUTH=1
# Extra Host names the backend answers to (comma-separated; ".example.com" also
# matches its subdomains). IP addresses, localhost, this machine's hostname and
# *.ts.net names are always accepted; other names get "403 Host not allowed"
# (DNS-rebinding protection). Needed e.g. for a reverse proxy on a custom domain.
# XY_ALLOWED_HOSTS=

# === Server Ports ===
PORT=8080
FRONTEND_PORT=3000
# Interface the backend API listens on (default: 127.0.0.1). Browsers reach the
# API through the HTTPS frontend on FRONTEND_PORT, and agents call it over
# loopback. 0.0.0.0 re-exposes the plain-HTTP API (no TLS, agent hook endpoints
# included) to every network this machine is on.
# BACKEND_HOST=127.0.0.1

# === Advanced / Paths ===
# Database path (default: data/orchestrator.db)
# DB_PATH=data/orchestrator.db
# Log directory (default: logs/)
# LOG_DIR=logs
# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
# Fallback for attachments uploaded without a project; attachments
# with a project go to `<project>/.xylocopa/uploads/`.
# UPLOADS_DIR=~/.xylocopa/uploads
